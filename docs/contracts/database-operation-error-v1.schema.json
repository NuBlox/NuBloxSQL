{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nubloxsql:database-operation-error:1.0.0",
  "title": "NuBloxSQL TASK-001 safe database error v1",
  "description": "Proposed public redacted failure contract. Never propagate DBMS raw error text, hosts, DSNs, credentials or stack traces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "code",
    "message",
    "retryable"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "operation": {
      "const": "database.inspect"
    },
    "code": {
      "enum": [
        "INVALID_INPUT",
        "UNSUPPORTED_ENGINE",
        "AUTH_FAILED",
        "TLS_UNVERIFIED",
        "CONNECT_FAILED",
        "TIMEOUT",
        "CANCELLED",
        "PERMISSION_DENIED",
        "DISCOVERY_FAILED",
        "OUTPUT_FAILED"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Stable safe generalised message; no raw vendor diagnostic, credentials, DSNs or server host."
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
