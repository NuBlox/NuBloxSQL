{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nubloxsql:database-inventory:1.0.0",
  "title": "NuBloxSQL database inventory work product, proposal v1",
  "description": "Proposed typed evidence output for TASK-001; observed-only native database inventory. Not a runtime support claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "status",
    "target",
    "transportSecurity",
    "capture",
    "capabilities",
    "databases",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "operation": {
      "const": "database.inspect"
    },
    "status": {
      "enum": [
        "completed",
        "partial"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "engineId",
        "engineVersion",
        "serverVersionNumber",
        "currentDatabase",
        "currentPrincipal"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Non-secret user-defined profile alias, never endpoint or full connection URL"
        },
        "engineId": {
          "const": "postgresql",
          "description": "TASK-001 initial PostgreSQL profile only, not a universal adapter claim"
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "serverVersionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "currentDatabase": {
          "type": "string",
          "minLength": 1
        },
        "currentPrincipal": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transportSecurity": {
      "enum": [
        "verified-tls",
        "isolated-local"
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "maxDatabases",
        "truncated",
        "completeness"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "maxDatabases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "truncated": {
          "type": "boolean"
        },
        "completeness": {
          "const": "observed-only"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "state": {
            "enum": [
              "supported",
              "unsupported",
              "unknown"
            ]
          },
          "evidence": {
            "enum": [
              "native-observation",
              "version-contract",
              "not-observed"
            ]
          }
        }
      }
    },
    "databases": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "accessible"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "accessible": {
            "type": "boolean"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture": {
            "properties": {
              "truncated": {
                "const": true
              }
            },
            "required": [
              "truncated"
            ]
          }
        },
        "required": [
          "capture"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      }
    }
  ]
}
