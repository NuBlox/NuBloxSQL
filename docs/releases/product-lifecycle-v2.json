{
  "schemaVersion": 2,
  "product": "NuBloxSQL",
  "promise": "One coherent API for the complete SQL database lifecycle.",
  "designRule": "One developer API, honest dialect semantics.",
  "supportedEngines": [
    "postgresql",
    "mysql",
    "sqlite",
    "sqlserver"
  ],
  "phases": [
    {
      "id": "select",
      "order": 1,
      "purpose": "Choose engine, version, edition/distribution and deployment intent using compatibility evidence."
    },
    {
      "id": "install",
      "order": 2,
      "purpose": "Acquire and install the database engine/runtime through an explicit database lifecycle provider."
    },
    {
      "id": "initialize",
      "order": 3,
      "purpose": "Create and verify the initial cluster, instance, data directory or database-file runtime state."
    },
    {
      "id": "discover",
      "order": 4,
      "purpose": "Understand an initialized or existing database environment before changing it."
    },
    {
      "id": "establish",
      "order": 5,
      "purpose": "Bootstrap and configure the initialized database runtime for its intended use."
    },
    {
      "id": "build",
      "order": 6,
      "purpose": "Create database structures and initial data safely."
    },
    {
      "id": "use",
      "order": 7,
      "purpose": "Execute application workloads through the runtime."
    },
    {
      "id": "understand",
      "order": 8,
      "purpose": "Inspect metadata, structure, dependencies, capabilities, configuration and diagnostics."
    },
    {
      "id": "operate",
      "order": 9,
      "purpose": "Maintain, secure, monitor, back up and recover production databases."
    },
    {
      "id": "change",
      "order": 10,
      "purpose": "Evolve schemas, data, configuration, security, capacity and engine/runtime versions safely."
    },
    {
      "id": "retire",
      "order": 11,
      "purpose": "Archive, revoke, decommission and evidence database and engine/runtime retirement."
    }
  ],
  "domains": [
    {
      "id": "engine-lifecycle",
      "name": "Engine lifecycle and installation"
    },
    {
      "id": "runtime",
      "name": "Connectivity and runtime"
    },
    {
      "id": "language",
      "name": "SQL language"
    },
    {
      "id": "intelligence",
      "name": "Database intelligence"
    },
    {
      "id": "engineering",
      "name": "Database engineering"
    },
    {
      "id": "administration",
      "name": "Database administration"
    },
    {
      "id": "operations",
      "name": "Database operations"
    },
    {
      "id": "portability-governance",
      "name": "Portability and governance"
    }
  ],
  "infrastructureBoundary": {
    "owns": [
      "engine/version/edition selection evidence",
      "database-specific installation prerequisites and plans",
      "engine installation through explicit providers",
      "cluster/instance/data-directory/file initialization",
      "database/server discovery",
      "database bootstrap",
      "database/catalog/schema creation",
      "database configuration",
      "database security administration",
      "database maintenance",
      "backup/recovery integration",
      "replication/HA visibility",
      "engine upgrade planning and verification",
      "database retirement",
      "engine/runtime decommission through explicit providers"
    ],
    "doesNotOwn": [
      "cloud account/subscription creation",
      "generic VM provisioning",
      "VPC/VNET creation",
      "general firewall administration",
      "Kubernetes cluster management",
      "corporate DNS administration",
      "arbitrary operating-system management",
      "general infrastructure-as-code"
    ]
  },
  "terminology": {
    "dialect": "NuBloxSQL semantic/runtime support model for a database family.",
    "engineRuntime": "Installable or embeddable database software.",
    "managedResource": "Concrete cluster, instance, database, schema or SQLite file managed through the lifecycle."
  },
  "authoritativeDocument": "docs/strategy/PRODUCT-DEFINITION.md",
  "detailedLifecycleDocument": "docs/strategy/END-TO-END-DATABASE-LIFECYCLE.md"
}
