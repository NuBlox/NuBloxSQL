{
  "schemaVersion": 1,
  "kind": "nubloxsql-product-surface-model",
  "authority": "docs/product/BLUEPRINT.md",
  "requirements": "docs/product/database-profession-work-register.json",
  "products": [
    {
      "id": "driver",
      "name": "NuBloxSQL",
      "kind": "universal-database-driver",
      "root": ".",
      "entry": "index.js",
      "consumes": [],
      "owns": [
        "native-driver-protocols",
        "dialect-semantics",
        "public-sql-api",
        "database-lifecycle-primitives",
        "native-query-model-extensions",
        "cross-model-capability-discovery",
        "cloud-placement-connectivity-contracts"
      ],
      "mustNotOwn": [
        "career-entitlements",
        "user-interface",
        "force-non-sql-engines-through-sql"
      ]
    },
    {
      "id": "shell",
      "name": "NuBloxSQL Shell",
      "kind": "terminal-application",
      "root": "apps/shell",
      "entry": "apps/shell/bin/nublox.js",
      "consumes": [
        "driver"
      ],
      "owns": [
        "repl",
        "automation",
        "lifecycle-cli",
        "work-product-output"
      ],
      "mustNotOwn": [
        "native-driver-protocols",
        "dialect-implementation"
      ]
    },
    {
      "id": "workbench",
      "name": "NuBloxSQL Workbench",
      "kind": "graphical-application",
      "root": "apps/workbench",
      "entry": "apps/workbench/bin/nublox-workbench.js",
      "consumes": [
        "driver"
      ],
      "owns": [
        "graphical-exploration",
        "sql-editor",
        "guided-professional-workflows",
        "work-product-presentation"
      ],
      "mustNotOwn": [
        "native-driver-protocols",
        "dialect-implementation"
      ]
    }
  ],
  "workModel": {
    "unit": "activity",
    "evidence": "work-product",
    "streams": [
      "governance",
      "delivery"
    ],
    "authorization": "actual-principal-action-and-target-not-career-title",
    "phasesSource": "docs/product/database-profession-work-register.json"
  },
  "qualification": "Separate evidence per driver engine, Shell and Workbench; planned professional coverage is not implementation coverage."
}
