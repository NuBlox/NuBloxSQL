{
  "name": "@nublox/mysql",
  "description": "NuBlox mastered high-resilience MySQL client for modern Node.js applications.",
  "version": "3.1.0-nublox.1",
  "license": "MIT",
  "author": "Felix Geisendörfer <felix@debuggable.com> (http://debuggable.com/)",
  "contributors": [
    "Andrey Sidorov <sidorares@yandex.ru>",
    "Bradley Grainger <bgrainger@gmail.com>",
    "Douglas Christopher Wilson <doug@somethingdoug.com>",
    "Diogo Resende <dresende@thinkdigital.pt>",
    "Nathan Woltman <nwoltman@outlook.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NuBlox/NuBloxSQL.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./promise": {
      "types": "./promise.d.ts",
      "import": "./promise.mjs",
      "require": "./promise.js",
      "default": "./promise.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "bignumber.js": "9.0.2",
    "named-placeholders": "1.1.6",
    "safe-buffer": "5.2.1",
    "sqlstring": "2.3.3"
  },
  "devDependencies": {
    "after": "0.8.2",
    "eslint": "7.32.0",
    "mysql2": "3.24.4",
    "seedrandom": "3.0.5",
    "selfsigned": "5.5.0",
    "urun": "0.0.8",
    "utest": "0.0.8"
  },
  "files": [
    "lib/",
    "compatibility/",
    "docs/compatibility/",
    "Changes.md",
    "License",
    "Readme.md",
    "NUBLOX-MASTERED-PACKAGE.md",
    "NUBLOX-MYSQL-ROADMAP.md",
    "NUBLOX-UPSTREAM.json",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "promise.js",
    "promise.mjs",
    "promise.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "benchmark:mysql2": "node benchmark/competitors/mysql2-query.js",
    "benchmark:mysql2:prepared": "node --expose-gc benchmark/competitors/mysql2-prepared.js",
    "benchmark:packet-writer": "node --expose-gc benchmark/packet-writer-allocation.js",
    "benchmark:parser-fragmentation": "node --expose-gc benchmark/parser-fragmentation.js",
    "compatibility:check": "node tool/check-compatibility-manifest.js",
    "lint": "eslint . && node tool/lint-readme.js",
    "test": "node test/run.js",
    "test:binary-results": "node test/integration/binary-result-matrix-smoke.js",
    "test:compat:mysql2": "node test/compatibility/mysql2/live.js",
    "test:compat:mysql2:cache": "node test/compatibility/mysql2/cache-live.js",
    "test:compat:mysql2:contract": "node test/compatibility/mysql2/contract.js",
    "test:compat:mysql2:execute": "node test/compatibility/mysql2/execute-live.js",
    "test:compat:mysql2:named": "node test/compatibility/mysql2/named-placeholders-live.js",
    "test:compat:mysql2:prepare": "node test/compatibility/mysql2/prepare-live.js",
    "test:compat:mysql2:reset": "node test/compatibility/mysql2/reset-live.js",
    "test:compression:zlib": "node test/integration/zlib-compression-smoke.js",
    "test:compression:zstd": "node test/integration/zstd-compression-smoke.js",
    "test:esm": "node test/compatibility/esm-contract.mjs",
    "test:pool-warmup": "node test/integration/pool-warmup-smoke.js",
    "test:temporal-json-parameters": "node test/integration/temporal-json-parameters-smoke.js",
    "test:typed-parameters": "node test/integration/typed-parameters-smoke.js",
    "test:unit": "FILTER=unit node test/run.js",
    "test-ci": "node tool/install-nyc.js --nyc-optional --reporter=lcovonly --reporter=text -- npm test",
    "test-cov": "node tool/install-nyc.js --reporter=html --reporter=text -- npm test",
    "verify": "npm run lint && npm run test:unit && npm run compatibility:check && npm run test:compat:mysql2:contract && npm run test:esm && npm pack --dry-run"
  },
  "nublox": {
    "packageType": "NuBlox Mastered Package",
    "upstream": "mysqljs/mysql@dc9c152a87ec51a1f647447268917243d2eab1fd",
    "compatibilityLineage": "mysqljs/mysql 2.18.1"
  }
}
