{
  "name": "nubloxsql",
  "version": "1.0.0",
  "private": false,
  "description": "One NuBloxSQL entry point for multi-dialect SQL database integration.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Stephen J T Spittal",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "packages/sql-core/index.js",
    "packages/sql-core/index.d.ts",
    "packages/mysql/index.js",
    "packages/mysql/index.d.ts",
    "packages/mysql/types.d.ts",
    "packages/mysql/lib/",
    "packages/postgresql/index.js",
    "packages/postgresql/index.d.ts",
    "packages/postgresql/lib/",
    "packages/sqlite/index.js",
    "packages/sqlite/index.d.ts",
    "packages/sqlite/lib/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {"type":"git","url":"git+https://github.com/NuBlox/NuBloxSQL.git"},
  "workspaces": ["packages/*"],
  "engines": {"node": ">=22"},
  "scripts": {
    "test:platform": "node test/platform-entry.js",
    "test:mysql": "npm run test --workspace @nublox/mysql",
    "test:sql-core": "npm run test --workspace @nublox/sql-core && node test/dialect-contracts.js && node test/sql-core-v1-contract.js",
    "test:postgresql": "npm run test --workspace @nublox/postgresql",
    "test:sqlite": "npm run test --workspace @nublox/sqlite",
    "v1:proprietary-audit": "node tool/check-proprietary-v1.js",
    "v1:release-audit": "node tool/check-release-v1.js",
    "verify": "npm run test:platform && npm run test:mysql && npm run test:sql-core && npm run test:postgresql && npm run test:sqlite",
    "verify:proprietary": "npm run verify && npm run v1:proprietary-audit && npm run v1:release-audit"
  }
}
