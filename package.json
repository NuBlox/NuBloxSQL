{
  "name": "nubloxsql",
  "version": "0.0.0",
  "private": true,
  "description": "NuBloxSQL multi-dialect SQL driver platform.",
  "license": "Apache-2.0",
  "author": "Stephen J T Spittal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NuBlox/NuBloxSQL.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run verify --workspace @nublox/mysql && npm run test --workspace @nublox/sql-core && npm run test --workspace @nublox/postgresql && node test/dialect-contracts.js",
    "verify:mysql": "npm run verify --workspace @nublox/mysql",
    "test:sql-core": "npm run test --workspace @nublox/sql-core",
    "test:postgresql": "npm run test --workspace @nublox/postgresql",
    "test:types": "npm run test:types --workspace @nublox/mysql",
    "test:prepared-cursor": "npm run test:prepared-cursor --workspace @nublox/mysql"
  }
}
