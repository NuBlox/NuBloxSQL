{
  "name": "nubloxsql-rebuild",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p packages/driver/tsconfig.json && tsc -p apps/shell/tsconfig.json",
    "check:structure": "node scripts/check-structure.mjs",
    "test:unit": "npm run check:structure && npm run build && node --test tests/unit/*.test.mjs",
    "test:live": "npm run build && node --test tests/integration/postgresql/inventory.test.mjs",
    "test": "npm run test:unit",
    "verify": "npm run test:unit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.0.0"
  }
}
